         const MailgunClient = require('../lib/MailgunClient');
@@ -80,10 +81,12 @@ class EmailServiceWrapper {
             }
         });
 
-        const mailgunEmailProvider = new MailgunEmailProvider({
-            mailgunClient,
-            errorHandler
-        });
+        const emailProvider = configService.get('adapters:email')
+            ? adapterManager.getAdapter('email')
