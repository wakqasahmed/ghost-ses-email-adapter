# Ghost email adapter wiring patch
#
# Target runtime: ghost:6-alpine, embedded Ghost v6.53.0
# Apply from /var/lib/ghost/current with one command:
#   git apply /path/to/ghost-6.x-email-adapter-wiring.patch

diff --git a/core/server/adapters/email/email-provider-base.js b/core/server/adapters/email/email-provider-base.js
new file mode 100644
--- /dev/null
+++ b/core/server/adapters/email/email-provider-base.js
@@ -0,0 +1,21 @@
+'use strict';
+
+const errors = require('@tryghost/errors');
+
+class EmailProviderBase {
+    constructor(config) {
+        Object.defineProperty(this, 'requiredFns', {
+            value: ['send'],
+            writable: false
+        });
+
+        this.config = config || {};
+    }
+
+    async send() {
+        throw new errors.IncorrectUsageError({
+            message: 'send() must be implemented by email provider adapter'
+        });
+    }
+}
+module.exports = EmailProviderBase;
